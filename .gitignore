# Archives & compressed exports
*.tar
*.tar.*
*.gz
*.zip
*.7z
*.xz

# WSL distribution & package files
*.wsl

# Virtual disk images
*.vhdx
*.vhd

# Shortcut & Icon assets
*.ico

# VM Instances & Virtual Disks (track folder structure with .gitkeep)
/VMs/*
!/VMs/.gitkeep

# Standalone Ubuntu directory
/Ubuntu/
